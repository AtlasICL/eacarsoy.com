{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site served by Workers static assets (no Worker script).
  // Everything under ./web is uploaded; tooling stays at the repo root.
  "name": "acarsoy-co-uk",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web",
    // /projects serves projects.html, and /projects.html redirects to
    // /projects, matching the old Pages behaviour and the sitemap URLs.
    "html_handling": "auto-trailing-slash",
    // Pages served 404.html for unknown paths automatically; Workers
    // needs this set explicitly.
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "eacarsoy.com", "custom_domain": true },
    { "pattern": "www.eacarsoy.com", "custom_domain": true },
  ],
}
